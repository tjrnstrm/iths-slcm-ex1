# Copy to .env.local for local development:  cp .env.example .env.local
# Production values are set in the Render dashboard, never committed to git.

# development | production – shown as a badge in the UI, sets defaults below
APP_ENV=development

# debug | info | warn | error  (default: debug in development, info in production)
LOG_LEVEL=debug

# Maximum number of bookings the app accepts (positive integer, default 20)
MAX_BOOKINGS=5

# SECRET – protects DELETE /api/bookings (sent as the x-admin-key header).
# Generate one with:  node -e "console.log(crypto.randomUUID())"
ADMIN_API_KEY=change-me
